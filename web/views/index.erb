<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="trmnl-view" content="<%= @view %>">
    <meta name="live-reload" content="<%= @live_reload %>">
    
    <title>TRMNL Preview</title>
    
    <link rel="stylesheet" href="/index.css">
    <script src="/trmnl-picker.js"></script>
    <script src="/index.js"></script>

    <!-- Highlight.js for syntax highlighting -->
    <link rel="stylesheet" href="/highlight/styles/atom-one-dark.min.css">
    <script src="/highlight/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
</head>
<body>
    <main>
        <div class="tabs">
            <a class="tab <%= 'active' if @view == 'full' %>" href="/full">Full</a>
            <a class="tab <%= 'active' if @view == 'half_horizontal' %>" href="/half_horizontal">Half Horizontal</a>
            <a class="tab <%= 'active' if @view == 'half_vertical' %>" href="/half_vertical">Half Vertical</a>
            <a class="tab <%= 'active' if @view == 'quadrant' %>" href="/quadrant">Quadrant</a>
            <div style="flex-grow: 1;"></div>
            <div class="spinner" style="display: none;"></div>
        </div>

        <menu>
            <form id="picker-form">
                <!-- Required: Model selector -->
                <select data-model-select></select>

                <!-- Required: Palette selector -->
                <select data-palette-select></select>

                <!-- Optional: Orientation toggle -->
                <button class="btn" type="button" data-orientation-toggle>
                    <span data-orientation-text>Landscape</span>
                </button>

                <!-- Optional: Dark mode toggle -->
                <button class="btn" type="button" data-dark-mode-toggle>
                    <span data-dark-mode-text>Light Mode</span>
                </button>

                <!-- Optional: Reset button -->
                <button class="btn" type="button" data-reset-button>Reset</button>
            </form>

            <div style="display: flex; gap: 0.3em; align-items: center;">
                <select class="select-format">
                    <option value="png">PNG</option>
                    <option value="html" selected>HTML</option>
                </select>

                <a href="/poll" class="btn">Poll</a>
            </div>
        </menu>

        <% if @oauth_session&.connected? %>
          <div class="oauth-banner" style="padding: 0.5em 0.75em; margin: 0.5em 0; background: #efe; border: 1px solid #3a3; border-radius: 4px; color: #060;">OAuth account connected (beta). <a href="/oauth/disconnect">Disconnect</a> · <a href="https://github.com/usetrmnl/trmnlp/issues" target="_blank" rel="noopener">Report an issue</a></div>
        <% elsif @oauth_session&.configured? %>
          <div class="oauth-banner" style="padding: 0.5em 0.75em; margin: 0.5em 0; background: #eef; border: 1px solid #66c; border-radius: 4px; color: #234;"><a href="/oauth/connect">Connect account</a> to authorize this plugin's OAuth requests. OAuth is in beta. <a href="https://github.com/usetrmnl/trmnlp/issues" target="_blank" rel="noopener">Report an issue</a>.</div>
        <% end %>

        <% if @transform_error %>
          <div class="transform-error" style="padding: 0.5em 0.75em; margin: 0.5em 0; background: #fee; border: 1px solid #c33; border-radius: 4px; color: #900; font-family: monospace; white-space: pre-wrap;">Transform error: <%= h @transform_error %></div>
        <% end %>

        <iframe style="width: 800px; height: 480px; border: 1px solid black; background: white;">Rendering…</iframe>

        <!-- Custom Fields Editor -->
        <details id="custom-fields-editor" class="custom-fields-editor">
            <summary>Custom Fields</summary>
            <div id="custom-fields-container"></div>
            <div id="custom-fields-error" class="custom-fields-error" hidden></div>
            <div class="custom-fields-actions">
                <button class="btn" id="add-field-btn">+ Add Field</button>
                <button class="btn btn-primary" id="save-fields-btn">Save & Reload</button>
            </div>
        </details>

        <div class="payload-size <%= payload_size_class(@payload_size) %>">Payload: <%= format_bytes(@payload_size) %></div>
        <pre id="user-data"><code><%= h @user_data %></code></pre>
    </main>
</body>
</html>