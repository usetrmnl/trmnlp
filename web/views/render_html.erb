<!DOCTYPE html>
<html>
  <head>
    <script>
      const [andXMorePrefix, andXMoreSuffix] = <%= @and_x_more.to_json %>;
      window.I18n = { andXMore: (count) => `${andXMorePrefix} ${count} ${andXMoreSuffix}` };

      // Copied from TRMNL's plugin_rendering.js: the PNG capture waits for TRMNL_HIGHCHARTS_DONE.
      document.addEventListener("DOMContentLoaded", () => {
        if (!window.Highcharts) {
          window.TRMNL_HIGHCHARTS_DONE = true;
          return;
        }

        let counter = 0;
        const settle = () => {
          const allReady = Highcharts.charts.every(c => c && c.renderer && c.renderer.boxWrapper);
          if (!allReady && counter <= 50) return false; // 5 second timeout

          // A chart drawn before the title bar clamped its slot falls back to a 400px height.
          Highcharts.charts.forEach(c => {
            if (!c || !c.renderTo) return;
            const w = c.renderTo.offsetWidth;
            const h = c.renderTo.offsetHeight;
            if (h && Math.round(c.chartHeight) !== Math.round(h)) c.setSize(w, h, false);
          });
          window.TRMNL_HIGHCHARTS_DONE = true;
          return true;
        };

        if (settle()) return;

        const interval = setInterval(() => {
          counter++;
          if (settle()) clearInterval(interval);
        }, 100);
      });
    </script>
    <link rel="stylesheet" href="<%= @framework.css_url %>" />
    <% if @theme_css_url %><link rel="stylesheet" href="<%= @theme_css_url %>" /><% end %>
    <script src="<%= @framework.js_url %>"></script>
    <meta name="trmnl-framework-version" content="<%= @framework.number %>" />
    <meta name="trmnl-framework-pinned" content="<%= @framework.pinned? %>" />

    <!-- Begin Inter font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
    <!-- End Inter font -->
  </head>

  <body class="environment trmnl">
    <div class="<%= @screen_classes %>">
      <% if @mashup_classes %><div class="<%= @mashup_classes %>"><% end %>
      <div class="view view--<%= @view %>">
        <%= yield %>
      </div>
      <% if @mashup_classes %></div><% end %>
    </div>
  </body>
</html>
