#!/usr/bin/env bash
#
# This script was automatically generated by `trmnlp init` but it's yours to modify!
# Use this opportunity to set up environment variables, install dependencies, etc.
#

# Add a tag to stay on one release, v0.22.0 or later: trmnl/trmnlp:v0.22.0
IMAGE=trmnl/trmnlp

# Saved on the PATH as `trmnlp`, this script is what `command -v trmnlp` finds: not a gem.
GEM="$(command -v trmnlp)"
if [ -n "$GEM" ] && ! [ "$GEM" -ef "$0" ]
then
    exec "$GEM" "$@"
fi

if ! command -v docker &> /dev/null
then
    echo "Install the trmnl_preview gem:

  gem install trmnl_preview

Or install Docker:

    https://docs.docker.com/get-docker/"
    exit 1
fi

# The steps that run the image live in the image, so this copy in the plugin never goes out of date.
# Once a day a newer image is pulled and those steps are taken from it. With no network, the image
# already here is used.
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/trmnl"
RUN_IN_DOCKER="$CACHE_DIR/run_in_docker/${IMAGE//[^a-zA-Z0-9._-]/_}"
if [ -z "$(find "$RUN_IN_DOCKER" -mtime -1 2> /dev/null)" ]; then
    mkdir -p "$(dirname "$RUN_IN_DOCKER")"
    docker pull --quiet "$IMAGE" > /dev/null 2>&1
    if docker run --rm --entrypoint cat "$IMAGE" /app/templates/run_in_docker > "$RUN_IN_DOCKER.$$" 2> /dev/null
    then
        mv "$RUN_IN_DOCKER.$$" "$RUN_IN_DOCKER"
    else
        rm -f "$RUN_IN_DOCKER.$$"
    fi
fi

if ! [ -s "$RUN_IN_DOCKER" ]; then
    echo "Could not run $IMAGE. Check that Docker is running and that the image is v0.22.0 or later."
    exit 1
fi

IMAGE="$IMAGE" exec bash "$RUN_IN_DOCKER" "$@"
